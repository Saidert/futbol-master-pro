# Servidor y Entorno
NODE_ENV=development
PORT=5000

# Base de Datos PostgreSQL
# Soporta tanto URI (Render, Supabase, Neon, RDS) como parámetros individuales
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/football_master_pro
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=football_master_pro
DB_SSL=false

# Seguridad y Autenticación JWT
JWT_SECRET=super_secreto_seguro_football_master_pro_colombia_jwt_2026_key
JWT_EXPIRES_IN=24h

# Configuración CORS
CORS_ORIGIN=*
